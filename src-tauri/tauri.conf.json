{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aster Browser",
  "version": "0.1.0",
  "identifier": "com.aster.browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Aster Browser",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "center": true,
        "icon": "icons/icon.ico"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Aster",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}